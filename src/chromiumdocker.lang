# ============================================================
# Multilingual file for the TOS 7 Docker application "chromiumdocker".
# File name MUST be: <appid>.lang
# Superset of both official 14-language lists; untranslated nodes use English.
# Untranslated nodes fall back to English, which the official guide allows.
# ============================================================

[en-us]
  name         = "Chromium Web Browser"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium is the open-source web browser project behind Google Chrome. This app runs Chromium inside a container on your NAS and streams a complete Linux desktop to your browser through noVNC, so any device on the network can browse the web without installing a browser locally. Bookmarks, history, extensions, saved logins and downloads are kept on the NAS and survive restarts and updates."
  release_note = "1. Initial release. Runs the upstream Chromium image from Docker Hub (`accetto/debian-vnc-xfce-chromium-g3`, tag 13, Debian 13 base with a current Chromium) as a non-root user, with a desktop streamed over noVNC on port 8901. The VNC access password is generated randomly on first start and stored in the app data directory. Profile data persists under /Volume*/DockerAppData/chromiumdocker/."
  important    = "Requires DockerEngine (the App Center installs it automatically if missing). The container image is about 400 MB and is pulled from Docker Hub at install time; if your NAS cannot reach Docker Hub, configure a registry mirror in DockerEngine first. The VNC password is created on first start and written to /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - open it with an editor or the File Manager to read it. Chromium runs with --no-sandbox inside the container, which is required in this environment; avoid using it for sensitive browsing. Back up the whole DockerAppData/chromiumdocker directory before upgrading. On first start the app downloads about 78 MB of open-source Noto fonts (Chinese, Japanese, Korean, Arabic, Hebrew, Thai, Indic scripts and emoji) into the app data directory so pages in any language display correctly; set FONTS=off to skip it, or copy your own font files into the data directory's .local/share/fonts folder."

[zh-cn]
  name         = "Chromium 网页浏览器"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium 是 Google Chrome 背后的开源浏览器项目。本应用在 NAS 的容器中运行 Chromium，并通过 noVNC 把完整的 Linux 桌面串流到你的浏览器，因此局域网内任何设备都无需本地安装浏览器即可上网。书签、历史记录、扩展、已保存的登录信息与下载文件都保存在 NAS 上，重启或升级后依然保留。"
  release_note = "1. 首次发布。以非 root 用户运行 Docker Hub 的 Chromium 容器（标签 13），通过 noVNC 在 8901 端口串流桌面。VNC 访问密码在首次启动时随机生成并保存在应用数据目录中。配置文件数据持久化在 /Volume*/DockerAppData/chromiumdocker/。"
  important    = "需要 DockerEngine（缺失时应用中心会自动提示安装）。容器镜像约 400MB，安装时从 Docker Hub 拉取；若 NAS 无法直连 Docker Hub，请先在 DockerEngine 中配置镜像加速。VNC 密码在首次启动时生成并写入 /Volume*/DockerAppData/chromiumdocker/config/.vnc_password，可用编辑器或文件管理器打开查看。容器内 Chromium 以 --no-sandbox 运行（本环境所需），请勿用于敏感浏览。升级前请完整备份 DockerAppData/chromiumdocker 目录。 首次启动会自动下载约 78MB 开源 Noto 字体（中日韩、阿拉伯、希伯来、泰、印度语系及 emoji）到应用数据目录，以保证任意语言的网页正常显示；可用 FONTS=off 跳过，或自行把字体文件放入数据目录的 .local/share/fonts。"

[zh-hk]
  name         = "Chromium 網頁瀏覽器"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium 是 Google Chrome 背後的開源瀏覽器專案。本應用在 NAS 的容器中執行 Chromium，並透過 noVNC 把完整的 Linux 桌面串流到你的瀏覽器，因此區網內任何裝置都無需本機安裝瀏覽器即可上網。書籤、瀏覽記錄、擴充功能、已儲存的登入資訊與下載檔案都保存在 NAS 上，重新啟動或升級後依然保留。"
  release_note = "1. 首次發佈。以非 root 使用者執行 Docker Hub 的 Chromium 容器（標籤 13），透過 noVNC 在 8901 埠串流桌面。VNC 存取密碼在首次啟動時隨機產生並保存在應用資料目錄中。設定檔資料持久化於 /Volume*/DockerAppData/chromiumdocker/。"
  important    = "需要 DockerEngine（缺少時應用中心會自動提示安裝）。容器映像檔約 400MB，安裝時從 Docker Hub 下載；若 NAS 無法直連 Docker Hub，請先在 DockerEngine 中設定映像加速。VNC 密碼在首次啟動時產生並寫入 /Volume*/DockerAppData/chromiumdocker/config/.vnc_password，可用編輯器或檔案管理器開啟查看。容器內 Chromium 以 --no-sandbox 執行（本環境所需），請勿用於敏感瀏覽。升級前請完整備份 DockerAppData/chromiumdocker 目錄。 首次啟動會自動下載約 78MB 開源 Noto 字型（中日韓、阿拉伯、希伯來、泰、印度語系及 emoji）到應用資料目錄，確保任何語言的網頁正常顯示；可用 FONTS=off 略過，或自行把字型檔放入資料目錄的 .local/share/fonts。"

[fr-fr]
  name         = "Navigateur Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium est le projet de navigateur open source à l'origine de Google Chrome. Cette application exécute Chromium dans un conteneur sur votre NAS et diffuse un bureau Linux complet vers votre navigateur via noVNC : n'importe quel appareil du réseau peut donc naviguer sur le web sans installer de navigateur. Signets, historique, extensions, identifiants enregistrés et téléchargements restent sur le NAS et survivent aux redémarrages et aux mises à jour."
  release_note = "1. Version initiale. Exécute le conteneur Chromium de Docker Hub (tag 13) en tant qu'utilisateur non root, avec un bureau diffusé via noVNC sur le port 8901. Le mot de passe VNC est généré aléatoirement au premier démarrage et stocké dans le répertoire de données. Les données de profil persistent sous /Volume*/DockerAppData/chromiumdocker/."
  important    = "Nécessite DockerEngine (l'App Center l'installe automatiquement si absent). L'image fait environ 400 Mo et est téléchargée depuis Docker Hub à l'installation ; si votre NAS ne peut pas joindre Docker Hub, configurez d'abord un miroir de registre dans DockerEngine. Le mot de passe VNC est créé au premier démarrage dans /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - ouvrez-le avec un éditeur ou le gestionnaire de fichiers. Chromium s'exécute avec --no-sandbox dans le conteneur, ce qui est requis ici ; évitez la navigation sensible. Sauvegardez tout le dossier DockerAppData/chromiumdocker avant de mettre à jour. Au premier démarrage, l'application télécharge environ 78 Mo de polices Noto libres (CJK, arabe, hébreu, thaï, écritures indiennes et emoji) dans le dossier de données afin que les pages s'affichent correctement dans toutes les langues ; FONTS=off permet d'ignorer ce téléchargement, ou copiez vos polices dans .local/share/fonts du dossier de données."

[de-de]
  name         = "Chromium Webbrowser"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium ist das Open-Source-Browserprojekt hinter Google Chrome. Diese App führt Chromium in einem Container auf Ihrer NAS aus und überträgt einen vollständigen Linux-Desktop per noVNC in Ihren Browser. So kann jedes Gerät im Netzwerk im Web surfen, ohne lokal einen Browser zu installieren. Lesezeichen, Verlauf, Erweiterungen, gespeicherte Anmeldungen und Downloads liegen auf der NAS und überstehen Neustarts und Updates."
  release_note = "1. Erstveröffentlichung. Führt das Chromium-Image von Docker Hub (Tag 13) als Nicht-root-Benutzer aus; der Desktop wird per noVNC auf Port 8901 übertragen. Das VNC-Passwort wird beim ersten Start zufällig erzeugt und im Datenverzeichnis gespeichert. Profildaten bleiben unter /Volume*/DockerAppData/chromiumdocker/ erhalten."
  important    = "Erfordert DockerEngine (wird vom App Center bei Bedarf automatisch installiert). Das Image ist ca. 400 MB groß und wird bei der Installation von Docker Hub geladen; falls Ihre NAS Docker Hub nicht erreicht, richten Sie zuerst einen Registry-Mirror in DockerEngine ein. Das VNC-Passwort wird beim ersten Start in /Volume*/DockerAppData/chromiumdocker/config/.vnc_password geschrieben - mit Editor oder Dateimanager öffnen. Chromium läuft im Container mit --no-sandbox (hier erforderlich); bitte nicht für sensible Surfaktivitäten nutzen. Vor einem Update das gesamte Verzeichnis DockerAppData/chromiumdocker sichern. Beim ersten Start lädt die App ca. 78 MB freie Noto-Schriften (CJK, Arabisch, Hebräisch, Thai, indische Schriften, Emoji) in das Datenverzeichnis, damit Seiten in jeder Sprache korrekt dargestellt werden; mit FONTS=off lässt sich das überspringen, oder legen Sie eigene Schriftdateien in .local/share/fonts des Datenverzeichnisses ab."

[it-it]
  name         = "Browser Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium è il progetto di browser open source alla base di Google Chrome. Questa app esegue Chromium in un container sul NAS e trasmette un desktop Linux completo al browser tramite noVNC: qualsiasi dispositivo in rete può navigare senza installare un browser. Segnalibri, cronologia, estensioni, credenziali salvate e download restano sul NAS e sopravvivono a riavvii e aggiornamenti."
  release_note = "1. Versione iniziale. Esegue il container Chromium di Docker Hub (tag 13) come utente non root, con desktop trasmesso via noVNC sulla porta 8901. La password VNC viene generata casualmente al primo avvio ed è salvata nella cartella dati. I dati del profilo persistono in /Volume*/DockerAppData/chromiumdocker/."
  important    = "Richiede DockerEngine (l'App Center lo installa automaticamente se manca). L'immagine è di circa 400 MB e viene scaricata da Docker Hub all'installazione; se il NAS non raggiunge Docker Hub, configurare prima un mirror del registro in DockerEngine. La password VNC viene creata al primo avvio in /Volume*/DockerAppData/chromiumdocker/config/.vnc_password: aprirla con un editor o il file manager. Chromium gira nel container con --no-sandbox (necessario in questo ambiente); evitare la navigazione sensibile. Prima di aggiornare, eseguire il backup dell'intera cartella DockerAppData/chromiumdocker. Al primo avvio l'app scarica circa 78 MB di font Noto open source (CJK, arabo, ebraico, thai, scritture indiane ed emoji) nella cartella dati, così le pagine in qualsiasi lingua vengono visualizzate correttamente; FONTS=off salta il download, oppure copia i tuoi font in .local/share/fonts della cartella dati."

[es-es]
  name         = "Navegador Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium es el proyecto de navegador de código abierto en el que se basa Google Chrome. Esta aplicación ejecuta Chromium en un contenedor del NAS y transmite un escritorio Linux completo a su navegador mediante noVNC, de modo que cualquier dispositivo de la red puede navegar por Internet sin instalar un navegador. Marcadores, historial, extensiones, inicios de sesión guardados y descargas se conservan en el NAS y sobreviven a reinicios y actualizaciones."
  release_note = "1. Versión inicial. Ejecuta el contenedor Chromium de Docker Hub (etiqueta 13) como usuario no root, con el escritorio transmitido por noVNC en el puerto 8901. La contraseña de VNC se genera aleatoriamente en el primer arranque y se guarda en el directorio de datos. Los datos del perfil persisten en /Volume*/DockerAppData/chromiumdocker/."
  important    = "Requiere DockerEngine (el App Center lo instala automáticamente si falta). La imagen ocupa unos 400 MB y se descarga de Docker Hub durante la instalación; si su NAS no puede acceder a Docker Hub, configure antes un espejo de registro en DockerEngine. La contraseña de VNC se crea en el primer arranque en /Volume*/DockerAppData/chromiumdocker/config/.vnc_password: ábrala con un editor o el gestor de archivos. Chromium se ejecuta con --no-sandbox dentro del contenedor (necesario en este entorno); evite la navegación sensible. Haga copia de seguridad de toda la carpeta DockerAppData/chromiumdocker antes de actualizar. En el primer arranque la aplicación descarga unos 78 MB de fuentes Noto libres (CJK, árabe, hebreo, tailandés, escrituras indias y emoji) en el directorio de datos para que las páginas en cualquier idioma se muestren correctamente; con FONTS=off se omite, o copie sus fuentes en .local/share/fonts del directorio de datos."

[hu-hu]
  name         = "Chromium webböngésző"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "A Chromium a Google Chrome mögött álló nyílt forráskódú böngészőprojekt. Ez az alkalmazás a NAS-on lévő konténerben futtatja a Chromiumot, és a noVNC-n keresztül teljes Linux asztali környezetet közvetít a böngészőjébe, így a hálózat bármely eszköze tud webezni helyi böngésző telepítése nélkül. A könyvjelzők, az előzmények, a bővítmények, a mentett bejelentkezések és a letöltések a NAS-on maradnak, és túlélik az újraindítást és a frissítéseket."
  release_note = "1. Első kiadás. A Docker Hub Chromium konténerét (13 címke) futtatja nem root felhasználóként, az asztalt noVNC-n keresztül a 8901-es porton közvetíti. A VNC jelszó az első indításkor véletlenszerűen jön létre, és az adatkönyvtárban tárolódik. A profiladatok a /Volume*/DockerAppData/chromiumdocker/ alatt maradnak meg."
  important    = "DockerEngine szükséges (az App Center hiányában automatikusan telepíti). A konténerkép mintegy 400 MB, telepítéskor a Docker Hubról töltődik le; ha a NAS nem éri el a Docker Hubot, először állítson be tükört a DockerEngine-ben. A VNC jelszó az első indításkor a /Volume*/DockerAppData/chromiumdocker/config/.vnc_password fájlba kerül - szerkesztővel vagy fájlkezelővel nyissa meg. A Chromium a konténerben --no-sandbox kapcsolóval fut (itt ez szükséges); érzékeny böngészéshez ne használja. Frissítés előtt készítsen biztonsági mentést a teljes DockerAppData/chromiumdocker könyvtárról. Első indításkor az alkalmazás kb. 78 MB szabad Noto betűkészletet tölt le (CJK, arab, héber, thai, indiai írások, emoji) az adatkönyvtárba, hogy minden nyelvű oldal helyesen jelenjen meg; FONTS=off kapcsolóval kihagyható, vagy saját betűtípusokat másolhat az adatkönyvtár .local/share/fonts mappájába."

[ja-jp]
  name         = "Chromium ウェブブラウザ"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium は Google Chrome の基盤となるオープンソースのブラウザプロジェクトです。本アプリは NAS 上のコンテナで Chromium を実行し、noVNC を通じて完全な Linux デスクトップをお使いのブラウザにストリーミングします。ネットワーク上のどの端末からでも、ブラウザをインストールせずに Web を利用できます。ブックマーク、履歴、拡張機能、保存したログイン情報、ダウンロードは NAS に保存され、再起動やアップデート後も保持されます。"
  release_note = "1. 初回リリース。Docker Hub の Chromium コンテナ（タグ 13）を非 root ユーザーで実行し、noVNC でポート 8901 にデスクトップを配信します。VNC パスワードは初回起動時にランダム生成され、アプリのデータディレクトリに保存されます。プロファイルデータは /Volume*/DockerAppData/chromiumdocker/ に保持されます。"
  important    = "DockerEngine が必要です（未導入の場合はアプリセンターが自動で案内します）。イメージは約 400MB で、インストール時に Docker Hub から取得します。NAS から Docker Hub に到達できない場合は、先に DockerEngine でレジストリミラーを設定してください。VNC パスワードは初回起動時に /Volume*/DockerAppData/chromiumdocker/config/.vnc_password に作成されます。エディタまたはファイルマネージャで開いて確認してください。コンテナ内の Chromium は --no-sandbox で動作します（本環境では必須）。機密性の高い閲覧には使用しないでください。アップデート前に DockerAppData/chromiumdocker ディレクトリ全体をバックアップしてください。 初回起動時に約 78MB のオープンソース Noto フォント（中日韓・アラビア・ヘブライ・タイ・インド系文字・絵文字）をアプリのデータディレクトリへ自動ダウンロードし、あらゆる言語のページを正しく表示します。FONTS=off で省略可能。ご自身のフォントをデータディレクトリの .local/share/fonts に置いても構いません。"

[ko-kr]
  name         = "Chromium 웹 브라우저"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium은 Google Chrome의 기반이 되는 오픈 소스 브라우저 프로젝트입니다. 이 앱은 NAS의 컨테이너에서 Chromium을 실행하고 noVNC를 통해 완전한 Linux 데스크톱을 브라우저로 스트리밍하므로, 네트워크의 어떤 기기에서도 브라우저를 설치하지 않고 웹을 사용할 수 있습니다. 북마크, 방문 기록, 확장 프로그램, 저장된 로그인 정보와 다운로드는 NAS에 보관되어 재시작과 업데이트 후에도 유지됩니다."
  release_note = "1. 최초 릴리스. Docker Hub의 Chromium 컨테이너(태그 13)를 비root 사용자로 실행하고 noVNC를 통해 8901 포트로 데스크톱을 전송합니다. VNC 암호는 첫 시작 시 무작위로 생성되어 앱 데이터 디렉터리에 저장됩니다. 프로필 데이터는 /Volume*/DockerAppData/chromiumdocker/ 아래에 유지됩니다."
  important    = "DockerEngine이 필요합니다(없으면 앱 센터가 자동으로 안내합니다). 이미지는 약 400MB이며 설치 시 Docker Hub에서 내려받습니다. NAS에서 Docker Hub에 접속할 수 없다면 먼저 DockerEngine에서 레지스트리 미러를 설정하세요. VNC 암호는 첫 시작 시 /Volume*/DockerAppData/chromiumdocker/config/.vnc_password 에 생성되며 편집기나 파일 관리자로 확인할 수 있습니다. 컨테이너 내부의 Chromium은 --no-sandbox로 실행됩니다(이 환경에서 필요). 중요한 브라우징에는 사용하지 마세요. 업데이트 전에 DockerAppData/chromiumdocker 디렉터리 전체를 백업하세요. 첫 실행 시 약 78MB의 오픈소스 Noto 글꼴(중일한, 아랍어, 히브리어, 태국어, 인도계 문자, 이모지)을 앱 데이터 디렉터리로 내려받아 모든 언어의 페이지가 올바르게 표시됩니다. FONTS=off 로 건너뛸 수 있으며, 직접 글꼴 파일을 데이터 디렉터리의 .local/share/fonts 에 넣어도 됩니다."

[pl-pl]
  name         = "Przeglądarka Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium to otwartoźródłowy projekt przeglądarki, na którym opiera się Google Chrome. Ta aplikacja uruchamia Chromium w kontenerze na NAS i przesyła pełny pulpit Linuksa do przeglądarki przez noVNC, dzięki czemu każde urządzenie w sieci może korzystać z internetu bez instalowania przeglądarki. Zakładki, historia, rozszerzenia, zapisane loginy i pobrane pliki są przechowywane na NAS i przetrwają restarty oraz aktualizacje."
  release_note = "1. Pierwsze wydanie. Uruchamia kontener Chromium z Docker Hub (tag 13) jako użytkownik inny niż root, z pulpitem przesyłanym przez noVNC na porcie 8901. Hasło VNC jest generowane losowo przy pierwszym starcie i zapisywane w katalogu danych. Dane profilu są trwałe w /Volume*/DockerAppData/chromiumdocker/."
  important    = "Wymaga DockerEngine (App Center zainstaluje go automatycznie, jeśli go brak). Obraz ma około 400 MB i jest pobierany z Docker Hub podczas instalacji; jeśli NAS nie ma dostępu do Docker Hub, skonfiguruj najpierw mirror rejestru w DockerEngine. Hasło VNC jest tworzone przy pierwszym starcie w /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - otwórz je edytorem lub menedżerem plików. Chromium działa w kontenerze z --no-sandbox (wymagane w tym środowisku); nie używaj go do wrażliwego przeglądania. Przed aktualizacją wykonaj kopię całego katalogu DockerAppData/chromiumdocker. Przy pierwszym uruchomieniu aplikacja pobiera ok. 78 MB wolnych fontów Noto (CJK, arabskie, hebrajskie, tajskie, pisma indyjskie i emoji) do katalogu danych, aby strony w każdym języku wyświetlały się poprawnie; FONTS=off pomija to, albo skopiuj własne fonty do .local/share/fonts w katalogu danych."

[ru-ru]
  name         = "Веб-браузер Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium — это открытый проект браузера, на котором основан Google Chrome. Это приложение запускает Chromium в контейнере на вашем NAS и транслирует полноценный рабочий стол Linux в браузер через noVNC, поэтому любое устройство в сети может работать в интернете без установки браузера. Закладки, история, расширения, сохранённые логины и загрузки хранятся на NAS и сохраняются после перезапусков и обновлений."
  release_note = "1. Первый выпуск. Запускает контейнер Chromium из Docker Hub (тег 13) от имени пользователя без прав root; рабочий стол транслируется через noVNC на порту 8901. Пароль VNC создаётся случайным образом при первом запуске и сохраняется в каталоге данных. Данные профиля сохраняются в /Volume*/DockerAppData/chromiumdocker/."
  important    = "Требуется DockerEngine (App Center установит его автоматически при отсутствии). Образ занимает около 400 МБ и загружается из Docker Hub при установке; если NAS не имеет доступа к Docker Hub, сначала настройте зеркало реестра в DockerEngine. Пароль VNC создаётся при первом запуске в /Volume*/DockerAppData/chromiumdocker/config/.vnc_password — откройте его редактором или файловым менеджером. Chromium работает в контейнере с --no-sandbox (это необходимо в данной среде); не используйте его для конфиденциального просмотра. Перед обновлением сделайте резервную копию всего каталога DockerAppData/chromiumdocker. При первом запуске приложение загружает около 78 МБ свободных шрифтов Noto (CJK, арабский, иврит, тайский, индийские письменности, эмодзи) в каталог данных, чтобы страницы на любом языке отображались корректно; FONTS=off отключает загрузку, либо скопируйте свои шрифты в .local/share/fonts каталога данных."

[tr-tr]
  name         = "Chromium Web Tarayıcısı"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium, Google Chrome'un temelini oluşturan açık kaynak tarayıcı projesidir. Bu uygulama Chromium'u NAS'ınızdaki bir kapsayıcıda çalıştırır ve noVNC üzerinden eksiksiz bir Linux masaüstünü tarayıcınıza aktarır; böylece ağdaki her cihaz yerel tarayıcı kurmadan web'de gezinebilir. Yer imleri, geçmiş, uzantılar, kayıtlı oturum bilgileri ve indirmeler NAS'ta saklanır ve yeniden başlatma ile güncellemelerden sonra da kalır."
  release_note = "1. İlk sürüm. Docker Hub'daki Chromium kapsayıcısını (13 etiketi) root olmayan kullanıcı olarak çalıştırır ve masaüstünü noVNC ile 8901 numaralı bağlantı noktasından aktarır. VNC parolası ilk başlatmada rastgele üretilir ve uygulama veri dizininde saklanır. Profil verileri /Volume*/DockerAppData/chromiumdocker/ altında kalıcıdır."
  important    = "DockerEngine gerekir (eksikse App Center otomatik kurar). Kapsayıcı imajı yaklaşık 400 MB'dır ve kurulumda Docker Hub'dan indirilir; NAS'ınız Docker Hub'a erişemiyorsa önce DockerEngine'de bir kayıt defteri aynası yapılandırın. VNC parolası ilk başlatmada /Volume*/DockerAppData/chromiumdocker/config/.vnc_password dosyasına yazılır - bir düzenleyici veya dosya yöneticisiyle açın. Chromium kapsayıcı içinde --no-sandbox ile çalışır (bu ortamda gereklidir); hassas gezinme için kullanmayın. Güncellemeden önce DockerAppData/chromiumdocker klasörünün tamamını yedekleyin. İlk başlatmada uygulama, her dildeki sayfaların doğru görüntülenmesi için yaklaşık 78 MB açık kaynak Noto yazı tipini (CJK, Arapça, İbranice, Tayca, Hint yazıları, emoji) uygulama veri dizinine indirir; FONTS=off ile atlanabilir veya kendi yazı tiplerinizi veri dizinindeki .local/share/fonts klasörüne kopyalayabilirsiniz."

[pt-pt]
  name         = "Navegador Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "O Chromium é o projeto de navegador de código aberto que está na base do Google Chrome. Esta aplicação executa o Chromium num contentor no seu NAS e transmite um ambiente de trabalho Linux completo para o seu navegador através do noVNC, pelo que qualquer dispositivo da rede pode navegar na Internet sem instalar um navegador. Favoritos, histórico, extensões, inícios de sessão guardados e transferências ficam no NAS e sobrevivem a reinícios e atualizações."
  release_note = "1. Versão inicial. Executa o contentor Chromium do Docker Hub (etiqueta 13) como utilizador não root, com o ambiente de trabalho transmitido por noVNC na porta 8901. A palavra-passe VNC é gerada aleatoriamente no primeiro arranque e guardada no diretório de dados. Os dados de perfil persistem em /Volume*/DockerAppData/chromiumdocker/."
  important    = "Requer o DockerEngine (o App Center instala-o automaticamente se faltar). A imagem tem cerca de 400 MB e é obtida do Docker Hub na instalação; se o NAS não conseguir aceder ao Docker Hub, configure primeiro um espelho de registo no DockerEngine. A palavra-passe VNC é criada no primeiro arranque em /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - abra-a com um editor ou o gestor de ficheiros. O Chromium é executado com --no-sandbox dentro do contentor (necessário neste ambiente); evite navegação sensível. Faça cópia de segurança de toda a pasta DockerAppData/chromiumdocker antes de atualizar. No primeiro arranque a aplicação transfere cerca de 78 MB de tipos de letra Noto livres (CJK, árabe, hebraico, tailandês, escritas indianas e emoji) para a pasta de dados, para que as páginas em qualquer idioma sejam apresentadas corretamente; FONTS=off permite ignorar, ou copie os seus tipos de letra para .local/share/fonts da pasta de dados."

[ar-sa]
  name         = "متصفح Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "‏Chromium هو مشروع المتصفح مفتوح المصدر الذي يستند إليه Google Chrome. يشغّل هذا التطبيق Chromium داخل حاوية على وحدة NAS ويبثّ سطح مكتب Linux كاملاً إلى متصفحك عبر noVNC، بحيث يمكن لأي جهاز على الشبكة تصفّح الويب دون تثبيت متصفح محلياً. تُحفظ الإشارات المرجعية والسجل والإضافات وبيانات الدخول المحفوظة والتنزيلات على NAS وتبقى بعد إعادة التشغيل والتحديثات."
  release_note = "1. الإصدار الأول. يشغّل حاوية Chromium من Docker Hub (الوسم 13) بمستخدم غير جذر، ويبثّ سطح المكتب عبر noVNC على المنفذ 8901. تُولَّد كلمة مرور VNC عشوائياً عند أول تشغيل وتُخزَّن في مجلد بيانات التطبيق. تبقى بيانات الملف الشخصي في /Volume*/DockerAppData/chromiumdocker/."
  important    = "يتطلب DockerEngine (يثبّته App Center تلقائياً عند غيابه). حجم الصورة نحو 400 ميغابايت وتُنزَّل من Docker Hub عند التثبيت؛ إذا تعذّر وصول NAS إلى Docker Hub، فعيّن أولاً مرآة للسجل في DockerEngine. تُنشأ كلمة مرور VNC عند أول تشغيل في /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - افتحها بمحرّر نصوص أو مدير الملفات. يعمل Chromium داخل الحاوية بخيار --no-sandbox (وهو مطلوب في هذه البيئة)؛ تجنّب استخدامه للتصفح الحساس. انسخ مجلد DockerAppData/chromiumdocker بالكامل قبل التحديث. عند أول تشغيل يقوم التطبيق بتنزيل نحو 78 ميغابايت من خطوط Noto مفتوحة المصدر (الصينية اليابانية الكورية، العربية، العبرية، التايلاندية، الكتابات الهندية، والرموز التعبيرية) إلى مجلد بيانات التطبيق لتظهر صفحات أي لغة بشكل صحيح؛ يمكن تخطي ذلك بـ FONTS=off أو نسخ ملفات الخطوط إلى .local/share/fonts داخل مجلد البيانات."

[cs-cz]
  name         = "Webový prohlížeč Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium je open-source projekt prohlížeče, na kterém stojí Google Chrome. Tato aplikace spouští Chromium v kontejneru na vašem NAS a přenáší kompletní linuxovou plochu do vašeho prohlížeče přes noVNC, takže jakékoli zařízení v síti může prohlížet web bez instalace prohlížeče. Záložky, historie, rozšíření, uložená přihlášení a stažené soubory zůstávají na NAS a přežijí restarty i aktualizace."
  release_note = "1. První vydání. Spouští kontejner Chromium z Docker Hub (značka 13) jako uživatel bez oprávnění root, plocha je přenášena přes noVNC na portu 8901. Heslo VNC se při prvním spuštění vygeneruje náhodně a uloží se do datového adresáře. Data profilu přetrvávají v /Volume*/DockerAppData/chromiumdocker/."
  important    = "Vyžaduje DockerEngine (App Center jej v případě potřeby nainstaluje automaticky). Obraz má přibližně 400 MB a stahuje se z Docker Hub při instalaci; pokud NAS nedosáhne na Docker Hub, nastavte nejprve zrcadlo registru v DockerEngine. Heslo VNC se vytvoří při prvním spuštění v /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - otevřete jej editorem nebo správcem souborů. Chromium běží v kontejneru s --no-sandbox (v tomto prostředí je to nutné); nepoužívejte jej pro citlivé prohlížení. Před aktualizací zálohujte celý adresář DockerAppData/chromiumdocker. Při prvním spuštění aplikace stáhne přibližně 78 MB svobodných fontů Noto (CJK, arabština, hebrejština, thajština, indická písma, emoji) do datového adresáře, aby se stránky v jakémkoli jazyce zobrazovaly správně; FONTS=off to přeskočí, nebo zkopírujte vlastní fonty do .local/share/fonts v datovém adresáři."

[he-il]
  name         = "דפדפן Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "‏Chromium הוא פרויקט הדפדפן בקוד פתוח שעליו מבוסס Google Chrome. אפליקציה זו מריצה את Chromium במכולת (container) על ה-NAS ומשדרת שולחן עבודה מלא של Linux לדפדפן שלך באמצעות noVNC, כך שכל מכשיר ברשת יכול לגלוש באינטרנט בלי להתקין דפדפן. סימניות, היסטוריה, תוספים, פרטי התחברות שמורים והורדות נשמרים ב-NAS ושורדים אתחולים ועדכונים."
  release_note = "1. מהדורה ראשונה. מריץ את מכולת Chromium מ-Docker Hub (תג 13) כמשתמש שאינו root, עם שולחן עבודה המשודר ב-noVNC בפורט 8901. סיסמת ה-VNC נוצרת באקראי בהפעלה הראשונה ונשמרת בתיקיית הנתונים. נתוני הפרופיל נשמרים תחת /Volume*/DockerAppData/chromiumdocker/."
  important    = "נדרש DockerEngine (מרכז האפליקציות יתקין אותו אוטומטית אם חסר). גודל התמונה כ-400MB והיא נמשכת מ-Docker Hub בעת ההתקנה; אם ה-NAS אינו מגיע ל-Docker Hub, הגדר תחילה מראה (mirror) של המאגר ב-DockerEngine. סיסמת ה-VNC נוצרת בהפעלה הראשונה בקובץ /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - פתח אותו בעורך או במנהל הקבצים. ‏Chromium פועל במכולה עם --no-sandbox (נדרש בסביבה זו); אין להשתמש בו לגלישה רגישה. גבה את כל תיקיית DockerAppData/chromiumdocker לפני עדכון. בהפעלה הראשונה האפליקציה מורידה כ-78MB של גופני Noto בקוד פתוח (סינית/יפנית/קוריאנית, ערבית, עברית, תאית, כתבים הודיים ואימוג'י) לתיקיית הנתונים כדי שדפים בכל שפה יוצגו כראוי; FONTS=off מדלג על כך, או העתיקו קובצי גופן אל .local/share/fontsתיקיית הנתונים."

[id-id]
  name         = "Peramban Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium adalah proyek peramban sumber terbuka yang menjadi dasar Google Chrome. Aplikasi ini menjalankan Chromium di dalam kontainer pada NAS Anda dan menyiarkan desktop Linux lengkap ke peramban Anda melalui noVNC, sehingga perangkat apa pun di jaringan dapat menjelajah web tanpa memasang peramban. Markah, riwayat, ekstensi, login tersimpan, dan unduhan disimpan di NAS dan tetap ada setelah mulai ulang maupun pembaruan."
  release_note = "1. Rilis perdana. Menjalankan kontainer Chromium dari Docker Hub (tag 13) sebagai pengguna non-root, dengan desktop disiarkan melalui noVNC pada port 8901. Kata sandi VNC dibuat secara acak saat pertama kali dijalankan dan disimpan di direktori data aplikasi. Data profil tersimpan di /Volume*/DockerAppData/chromiumdocker/."
  important    = "Memerlukan DockerEngine (App Center akan memasangnya otomatis bila belum ada). Image berukuran sekitar 400 MB dan diunduh dari Docker Hub saat pemasangan; jika NAS tidak dapat menjangkau Docker Hub, konfigurasikan cermin registri di DockerEngine terlebih dahulu. Kata sandi VNC dibuat saat pertama kali dijalankan di /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - buka dengan editor atau File Manager. Chromium berjalan dengan --no-sandbox di dalam kontainer (diperlukan di lingkungan ini); jangan gunakan untuk penjelajahan sensitif. Cadangkan seluruh folder DockerAppData/chromiumdocker sebelum memperbarui. Saat pertama dijalankan, aplikasi mengunduh sekitar 78 MB font Noto sumber terbuka (CJK, Arab, Ibrani, Thai, aksara India, dan emoji) ke direktori data agar halaman dalam bahasa apa pun tampil dengan benar; FONTS=off melewatinya, atau salin font Anda ke .local/share/fonts di direktori data."

[nb-no]
  name         = "Chromium nettleser"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium er det åpne nettleserprosjektet som Google Chrome bygger på. Denne appen kjører Chromium i en container på NAS-en din og strømmer et komplett Linux-skrivebord til nettleseren din via noVNC, slik at enhver enhet på nettverket kan surfe på nettet uten å installere en nettleser. Bokmerker, historikk, utvidelser, lagrede pålogginger og nedlastinger ligger på NAS-en og overlever omstart og oppdateringer."
  release_note = "1. Første utgivelse. Kjører Chromium-containeren fra Docker Hub (tag 13) som en ikke-root-bruker, med skrivebordet strømmet via noVNC på port 8901. VNC-passordet genereres tilfeldig ved første oppstart og lagres i datamappen. Profildata bevares under /Volume*/DockerAppData/chromiumdocker/."
  important    = "Krever DockerEngine (App Center installerer det automatisk hvis det mangler). Avbildningen er omtrent 400 MB og hentes fra Docker Hub ved installasjon; hvis NAS-en ikke når Docker Hub, sett opp et register-speil i DockerEngine først. VNC-passordet opprettes ved første oppstart i /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - åpne det med et tekstprogram eller filbehandleren. Chromium kjører med --no-sandbox i containeren (nødvendig i dette miljøet); ikke bruk det til sensitiv surfing. Sikkerhetskopier hele DockerAppData/chromiumdocker-mappen før oppdatering. Ved første start laster appen ned ca. 78 MB med åpne Noto-skrifter (CJK, arabisk, hebraisk, thai, indiske skriftsystemer og emoji) til datamappen slik at sider på alle språk vises riktig; FONTS=off hopper over dette, eller kopier egne skriftfiler til .local/share/fonts i datamappen."

[nl-nl]
  name         = "Chromium webbrowser"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium is het opensource-browserproject achter Google Chrome. Deze app draait Chromium in een container op uw NAS en streamt een volledig Linux-bureaublad via noVNC naar uw browser, zodat elk apparaat in het netwerk kan internetten zonder een browser te installeren. Bladwijzers, geschiedenis, extensies, opgeslagen aanmeldingen en downloads staan op de NAS en blijven behouden na herstarts en updates."
  release_note = "1. Eerste release. Draait de Chromium-container van Docker Hub (tag 13) als niet-rootgebruiker, met het bureaublad gestreamd via noVNC op poort 8901. Het VNC-wachtwoord wordt bij de eerste start willekeurig gegenereerd en in de gegevensmap opgeslagen. Profielgegevens blijven bewaard onder /Volume*/DockerAppData/chromiumdocker/."
  important    = "Vereist DockerEngine (het App Center installeert dit automatisch indien nodig). De image is ongeveer 400 MB en wordt bij installatie van Docker Hub gehaald; als uw NAS Docker Hub niet kan bereiken, stel dan eerst een registry-mirror in DockerEngine in. Het VNC-wachtwoord wordt bij de eerste start aangemaakt in /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - open het met een editor of de bestandsbeheerder. Chromium draait in de container met --no-sandbox (noodzakelijk in deze omgeving); gebruik het niet voor gevoelig browsen. Maak een back-up van de hele map DockerAppData/chromiumdocker voordat u bijwerkt. Bij de eerste start downloadt de app ongeveer 78 MB vrije Noto-lettertypen (CJK, Arabisch, Hebreeuws, Thai, Indiase schriften en emoji) naar de gegevensmap zodat pagina's in elke taal goed worden weergegeven; met FONTS=off slaat u dit over, of kopieer uw eigen lettertypen naar .local/share/fonts in de gegevensmap."

[sv-se]
  name         = "Chromium webbläsare"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium är det öppna webbläsarprojekt som Google Chrome bygger på. Den här appen kör Chromium i en container på din NAS och strömmar ett komplett Linux-skrivbord till din webbläsare via noVNC, så att vilken enhet som helst i nätverket kan surfa utan att installera en webbläsare. Bokmärken, historik, tillägg, sparade inloggningar och nedladdningar ligger på NAS:en och finns kvar efter omstarter och uppdateringar."
  release_note = "1. Första utgåvan. Kör Chromium-containern från Docker Hub (tagg 13) som icke-root-användare, med skrivbordet strömmat via noVNC på port 8901. VNC-lösenordet skapas slumpmässigt vid första starten och sparas i datamappen. Profildata finns kvar under /Volume*/DockerAppData/chromiumdocker/."
  important    = "Kräver DockerEngine (App Center installerar det automatiskt om det saknas). Avbildningen är cirka 400 MB och hämtas från Docker Hub vid installationen; om NAS:en inte når Docker Hub, ställ först in en registry-spegel i DockerEngine. VNC-lösenordet skapas vid första starten i /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - öppna den med en editor eller filhanteraren. Chromium körs med --no-sandbox i containern (krävs i denna miljö); undvik känslig surfning. Säkerhetskopiera hela mappen DockerAppData/chromiumdocker före uppdatering. Vid första starten laddar appen ner cirka 78 MB fria Noto-typsnitt (CJK, arabiska, hebreiska, thai, indiska skrifter och emoji) till datamappen så att sidor på alla språk visas korrekt; FONTS=off hoppar över detta, eller kopiera egna typsnitt till .local/share/fonts i datamappen."

[th-th]
  name         = "เบราว์เซอร์ Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium เป็นโครงการเบราว์เซอร์โอเพนซอร์สที่เป็นพื้นฐานของ Google Chrome แอปนี้รัน Chromium ในคอนเทนเนอร์บน NAS ของคุณ และสตรีมเดสก์ท็อป Linux แบบเต็มไปยังเบราว์เซอร์ของคุณผ่าน noVNC อุปกรณ์ใดก็ได้ในเครือข่ายจึงท่องเว็บได้โดยไม่ต้องติดตั้งเบราว์เซอร์ บุ๊กมาร์ก ประวัติ ส่วนขยาย ข้อมูลเข้าสู่ระบบที่บันทึกไว้ และไฟล์ดาวน์โหลดจะถูกเก็บไว้บน NAS และคงอยู่หลังการรีสตาร์ทหรืออัปเดต"
  release_note = "1. เผยแพร่ครั้งแรก รันคอนเทนเนอร์ Chromium จาก Docker Hub (แท็ก 13) ด้วยผู้ใช้ที่ไม่ใช่ root และสตรีมเดสก์ท็อปผ่าน noVNC บนพอร์ต 8901 รหัสผ่าน VNC ถูกสร้างแบบสุ่มเมื่อเริ่มครั้งแรกและบันทึกไว้ในไดเรกทอรีข้อมูลของแอป ข้อมูลโปรไฟล์จะคงอยู่ใน /Volume*/DockerAppData/chromiumdocker/"
  important    = "ต้องมี DockerEngine (App Center จะติดตั้งให้อัตโนมัติหากไม่มี) อิมเมจมีขนาดประมาณ 400 MB และดาวน์โหลดจาก Docker Hub ตอนติดตั้ง หาก NAS เชื่อมต่อ Docker Hub ไม่ได้ ให้ตั้งค่า registry mirror ใน DockerEngine ก่อน รหัสผ่าน VNC จะถูกสร้างเมื่อเริ่มครั้งแรกที่ /Volume*/DockerAppData/chromiumdocker/config/.vnc_password เปิดอ่านได้ด้วยโปรแกรมแก้ไขข้อความหรือ File Manager ภายในคอนเทนเนอร์ Chromium ทำงานด้วย --no-sandbox (จำเป็นในสภาพแวดล้อมนี้) โปรดหลีกเลี่ยงการใช้งานที่ละเอียดอ่อน สำรองโฟลเดอร์ DockerAppData/chromiumdocker ทั้งหมดก่อนอัปเดต เมื่อเริ่มครั้งแรก แอปจะดาวน์โหลดฟอนต์ Noto โอเพนซอร์สประมาณ 78 MB (จีน/ญี่ปุ่น/เกาหลี อาหรับ ฮีบรู ไทย อักษรอินเดีย และอีโมจิ) ไปยังไดเรกทอรีข้อมูลของแอป เพื่อให้หน้าเว็บทุกภาษแสดงผลถูกต้อง ใช้ FONTS=off เพื่อข้าม หรือคัดลอกไฟล์ฟอนต์ของคุณไปที่ .local/share/fonts ในไดเรกทอรีข้อมูล"

[vi-vn]
  name         = "Trình duyệt Chromium"
  auth         = "accetto"
  version      = "@@VERSION@@"
  descript     = "Chromium là dự án trình duyệt mã nguồn mở đứng sau Google Chrome. Ứng dụng này chạy Chromium trong một container trên NAS và truyền toàn bộ màn hình Linux đến trình duyệt của bạn qua noVNC, nhờ đó mọi thiết bị trong mạng đều có thể lướt web mà không cần cài trình duyệt. Dấu trang, lịch sử, tiện ích mở rộng, thông tin đăng nhập đã lưu và tệp tải về được giữ trên NAS và vẫn còn sau khi khởi động lại hoặc cập nhật."
  release_note = "1. Bản phát hành đầu tiên. Chạy container Chromium từ Docker Hub (thẻ 13) với người dùng không phải root, truyền màn hình qua noVNC trên cổng 8901. Mật khẩu VNC được tạo ngẫu nhiên trong lần khởi động đầu và lưu trong thư mục dữ liệu của ứng dụng. Dữ liệu hồ sơ được lưu tại /Volume*/DockerAppData/chromiumdocker/."
  important    = "Cần DockerEngine (App Center sẽ tự động cài nếu thiếu). Image có dung lượng khoảng 400 MB và được tải từ Docker Hub khi cài đặt; nếu NAS không truy cập được Docker Hub, hãy cấu hình registry mirror trong DockerEngine trước. Mật khẩu VNC được tạo trong lần khởi động đầu tại /Volume*/DockerAppData/chromiumdocker/config/.vnc_password - mở bằng trình soạn thảo hoặc File Manager để xem. Chromium chạy với --no-sandbox trong container (cần thiết trong môi trường này); không dùng cho việc duyệt web nhạy cảm. Sao lưu toàn bộ thư mục DockerAppData/chromiumdocker trước khi nâng cấp. Ở lần khởi động đầu, ứng dụng tải khoảng 78 MB phông chữ Noto mã nguồn mở (CJK, Ả Rập, Do Thái, Thái, chữ Ấn Độ và emoji) vào thư mục dữ liệu để các trang bằng mọi ngôn ngữ hiển thị đúng; FONTS=off để bỏ qua, hoặc tự sao chép phông chữ vào .local/share/fonts trong thư mục dữ liệu."
